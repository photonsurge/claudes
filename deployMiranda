#!/usr/bin/env bash
# Deploy to miranda — the TEST box. It runs the :test images ./build pushes.
# (No building here — run ./build first to build+push.)
#
#   ./build && ./deployMiranda     # typical: build+push :test, then deploy it
#   ./deployMiranda                # deploy the already-pushed :test images
#   NO_UP=1 ./deployMiranda        # sync compose + env only, don't pull/restart
#   TAG=1.4.2 ./deployMiranda      # put one specific version tag on the test box
#   ENV_DEPLOY=.env.staging ./deployMiranda
#
# miranda has NO in-compose caddy: it sits behind the LAN nginx box
# (infra/nginx.weather-channel.conf). CADDY=0 makes ./deploy strip any
# COMPOSE_PROFILES line from the synced env, so the profile can't be switched
# on here by accident.
#
# Once it looks right on miranda, ./deployLive promotes :test -> :latest and
# deploys that to the live box. The body lives in ./deploy.
set -euo pipefail
cd "$(dirname "$0")"

HOST="${HOST:-miranda}" \
DIR="${DIR:-weather}" \
ENV_DEPLOY="${ENV_DEPLOY:-.env.deploy}" \
TAG="${TAG:-test}" \
CADDY=0 \
exec ./deploy
