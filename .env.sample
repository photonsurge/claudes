# ── Docker infra credentials ──────────────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme
REDIS_PASSWORD=changeme

# ── Core ──────────────────────────────────────────────────────────────────────
# Use docker service names as hostnames when running in compose (not 127.0.0.1).
MONGODB_URI=mongodb://admin:changeme@mongodb:27017/app?authSource=admin
REDIS_SERVER=redis
REDIS_PORT=6379
# Redis read-through cache for public feeds and bbox queries (seconds).
FEED_CACHE_TTL_SEC=600

# ── Auth secrets ──────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
JWT_SECRET=
WORKER_AUTH_SECRET=
SOCKET_TOKEN_SECRET=
SESSION_SECRET=

# ── Auth: admin accounts ───────────────────────────────────────────────────────
# Only used once, to bootstrap the first account (`cd worker && yarn seed:admin`).
# Not needed after that — create further admins from /admin/users.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ── Service wiring ────────────────────────────────────────────────────────────
# Docker: which host interface the published ports bind to. Default 127.0.0.1
# (loopback → front with nginx). Set 0.0.0.0 to reach 10100/10101 directly on the box.
BIND_HOST=127.0.0.1
# Hard memory ceiling for the public web container (Docker size syntax).
PUBLIC_MEMORY_LIMIT=4g
# V8 heap cap (MB) for that container. Keep it under PUBLIC_MEMORY_LIMIT — the
# gap absorbs non-heap RSS (sharp/glibc) so V8 GCs before Docker OOM-kills.
PUBLIC_NODE_HEAP_MB=3072
# Ports (kept off hydra's 3000/4000/5000): web 10100 · socket 10101 · worker 10102
# Worker -> socket server (server-to-server). In compose use the service host.
SOCKET_URL=http://socket:10101
# Browser -> socket server (must be reachable from the user's browser)
NEXT_PUBLIC_SOCKET_URL=http://localhost:10101
# Runtime override of that baked value, read by /api/auth/socket-token. The
# public image inlines NEXT_PUBLIC_* at build time and ./deployLive promotes the
# tested :test image to live unchanged — so a box on another domain sets this in
# its env instead of rebuilding. Leave unset locally.
# SOCKET_PUBLIC_URL=https://io.photonsurge.uk
# CORS allow-list for the socket server (comma separated)
ALLOWED_ORIGINS=http://localhost:10100

# Logical domain label carried on queue jobs (single-domain stack).
APP_DOMAIN=default

# ── Which box is this? (operator UI tint) ─────────────────────────────────────
# Three deployments run the SAME image — a dev machine, the test box (miranda,
# :test) and live (asguard, :latest) — and the consoles looked identical, which
# is how you reseed cities on live by accident. So /admin, /control, /login and
# the launcher wash their page background with a per-deployment colour and show
# a label; /watch is never touched.
#
# NOTHING TO SET. It reads TAG (which ./deploy pins into the env it syncs to
# each host): no tag = LOCAL violet, test = TEST amber, anything else = LIVE red.
# It has to be a runtime value, not NEXT_PUBLIC_*, because ./deployLive promotes
# the image miranda tested to live unchanged — a build-time flag would label
# live "TEST" forever.
#
# Override only to rename a box, recolour it, or switch the whole thing off:
# INSTANCE_ID=local|test|live|off
# INSTANCE_LABEL=STAGING
# INSTANCE_COLOR=#a855f7

# ── Caddy front door (opt-in: docker-compose `caddy` profile) ─────────────────
# In-compose HTTPS reverse proxy (infra/Caddyfile): Next at /, Socket.IO at
# /socket.io/ on ONE domain, Let's Encrypt automatic (DNS -> this box, 80/443
# open). Turn on per host with the profile + the domain; keep BIND_HOST on
# loopback (caddy reaches the services over the compose network) and point
# SOCKET_PUBLIC_URL / ALLOWED_ORIGINS at https://<SITE_DOMAIN>.
# COMPOSE_PROFILES=caddy
# SITE_DOMAIN=live.example.com
# CADDY_MEMORY_LIMIT=256m

# Image tag the stack runs (test | latest | <version>) — the image names in
# docker-compose.yml end in :${TAG}. ./deploy pins it into the .env it syncs to
# the host (test box = test, live box = latest); don't hand-set it in a deploy env.
# TAG=latest

# ── Weather pipeline (worker) ─────────────────────────────────────────
MODEL=gfs
FORECAST_HOURS=48
STEP_HOURS=3
RUN_CHECK_CRON=*/30 * * * *
RETAIN_RUNS=3
# ── Geocoding (web /api/geocode) ──────────────────────────────────────
GEOCODER_URL=https://nominatim.openstreetmap.org

# ── Live tracks (worker) ──────────────────────────────────────────────
# adsb (keyless, regional point+radius) or opensky (global /states/all, fills any
# view). OpenSky anonymous ~100 global calls/day → poll slow; add an API client
# (OPENSKY_CLIENT_ID/SECRET) to use AIRCRAFT_SNAPSHOT_MS=60000.
AIRCRAFT_PROVIDER=adsb
# AIRCRAFT_SNAPSHOT_MS=900000
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# ── Global weather-event round-ups (worker) ───────────────────────────
# Scheduled summaries of active events → /admin/summaries. LLM narrative is
# generated via OpenRouter (OpenAI-compatible); with no key set the round-up is
# still stored, just without prose.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Also used by: volcano bulletin parsing (OPENROUTER_VOLCANO_MODEL override) and
# alert translation (OPENROUTER_ALERTS_MODEL override) — same OPENROUTER_API_KEY.
OPENROUTER_ALERTS_MODEL=google/gemini-3.1-flash-lite
ALERTS_TRANSLATE_MS=900000
# Only translate Severe/Extreme alerts (rank ≥3 of 0-4) — lower this to widen scope.
ALERTS_TRANSLATE_SEVERITY_MIN=3
SUMMARIES_ENABLED=true
SUMMARY_HOURLY_CRON=0 * * * *
SUMMARY_12H_CRON=0 0,12 * * *
SUMMARY_DAILY_CRON=0 0 * * *
# Retention: 0 = keep every round-up forever (history feeds broadcast); >0 = TTL seconds.
SUMMARY_TTL_SEC=0

# ── Wildfires overlay (worker) ────────────────────────────────────────
# NASA FIRMS active-fire hot-spots. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without a key the fires.snapshot job is never scheduled — the overlay stays
# silently empty (toggle does nothing, no error).
# FIRMS_MAP_KEY=
# FIRE_SNAPSHOT_ENABLED=true
# FIRE_SNAPSHOT_MS=1800000
# FIRE_TTL_SEC=604800

# ── Active volcanoes overlay (worker) ─────────────────────────────────
# Smithsonian/USGS Weekly Volcanic Activity Report — keyless, always scheduled.
# GVP_WEEKLY_URL=https://volcano.si.edu/news/WeeklyVolcanoRSS.xml
# VOLCANO_SNAPSHOT_ENABLED=true
# VOLCANO_SNAPSHOT_MS=1800000
# VOLCANO_TTL_SEC=1209600

# ── Queue log endpoint (public /api/queue-logs) ───────────────────────
# Pull the worker's retained per-job console output via curl/tooling:
#   GET /api/queue-logs?key=…            → jobs that have logs
#   GET /api/queue-logs?key=…&jobId=…    → that job's lines
# Unset ⇒ the endpoint is admin-session-only (the /admin/queue card still works
# via the operator login; only keyless external access is disabled).
# QUEUE_LOG_KEY=change-me

# ── Live streaming: OBS + YouTube (worker) ────────────────────────────
# The operator "go live" flow (docs/streaming-runs-plan.md): the worker drives an
# OBS encoder over obs-websocket and manages the YouTube broadcast lifecycle.
#
# STEP-BY-STEP SETUP (where every value below comes from):
#   docs/youtube-setup.md   ← Google Cloud project, OAuth client, the 7-day token trap
#   docs/obs-setup.md       ← OBS websocket password, capture scene, encoder settings
#
# OBS: enable Tools → WebSocket Server Settings in OBS, set a password, and point
# the worker at it. Same box now, a GPU VM later — just change the URL. If OBS is
# unreachable the run waits in "awaiting-ingest" and the operator pastes the
# stream key into OBS by hand (no failure).
# OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
# OBS_WEBSOCKET_PASSWORD=
#
# Browser-source paint rate the worker stamps onto every auto-provisioned OBS
# browser source (10–60, default 30). THE fps knob for the /watch pages: bump it,
# restart the worker, and every go-live/recycle re-applies it. Keep it equal to
# each OBS instance's Settings → Video FPS (that one is set in OBS itself).
# OBS_BROWSER_FPS=30
#
# Go-live hard reset: by default each run TEARS DOWN and rebuilds its browser
# source (fresh Chromium, custom css carried over) and stops any stale streaming
# output first. Set "off" to fall back to a settings-restamp + no-cache refresh.
# OBS_HARD_PROVISION=on
#
# Instance sweep: every provision cuts an OBS instance down to the ONE channel it
# renders — other channels' globes and any duplicate /watch browser source are
# removed (each hidden one is still a full Chromium holding a socket + textures),
# along with our leftover scenes. Your own scenes/sources and the program scene
# are never touched. Set "off" for a hand-built instance you manage yourself.
# OBS_PRUNE=on
#
# YouTube: create a Google Cloud project, enable "YouTube Data API v3", make an
# OAuth 2.0 Web client, and register the redirect URI below. Then click
# "Connect YouTube" on /admin/streams and authorize the channel-owning account.
# The refresh token is stored ENCRYPTED in Mongo (never in env). CLIENT_SECRET is
# worker-only; CLIENT_ID + REDIRECT_URI are also read by public (non-secret).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://io.photonsurge.uk/google/redirect
#
# Key for encrypting stored secrets (YouTube refresh token) at rest. Either set
# APP_SECRET (any strong string; scrypt-derived) or SECRETBOX_KEY (32 bytes base64).
# APP_SECRET=change-me-long-random
# SECRETBOX_KEY=
#
# YouTube API budget + manners (worker). Access tokens refresh themselves from the
# stored refresh token — nothing to schedule. What DOES stop the API "after a
# while" is the 10,000 units/day project quota (resets midnight Pacific =
# 07:00/08:00 UK): live-chat polling at YouTube's suggested 2–5 s is ~90k
# units/day PER live run, so the worker meters spend (Redis, per Pacific day)
# and stretches chat polling to fit what's left. Raise DAILY after Google grants
# a quota extension; RESERVE is kept back for go-live/end (~200 units each);
# CHAT_QUOTA_SHARE is the fraction of the remaining budget chat may use.
# YOUTUBE_QUOTA_DAILY=10000
# YOUTUBE_QUOTA_RESERVE=1500
# YOUTUBE_CHAT_QUOTA_SHARE=0.6
# YOUTUBE_CHAT_POLL_MIN_MS=2000
# Per-call cost of liveChatMessages.list (Google's published tables have varied).
# YOUTUBE_QUOTA_COST_CHAT_LIST=5
# Bound on any single YouTube / token-endpoint request (a hung call would stall a
# run's monitor).
# YOUTUBE_API_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Storage retention (docs/blob-retention-plan.md)
#
# SET NOTHING HERE. Every knob below already defaults to the right value and the
# whole system runs itself: the daily sweeps register at boot, the seismic record
# seeds itself on the first start, and a past day is browsable at /admin/archive.
# These are listed so you know which dials exist, not because any need turning.
#
# Background: the blob folder reached 240 GB because two namespaces were
# unbounded -- the weather frame archive kept every frame forever while radar
# added one every two minutes, and alert imagery was never pruned by anything at
# all. Retention is now a SAMPLING rule: a full-res working set, then one keeper
# per thing per UTC day.
#
# Weather frame archive. Everything inside FULLRES_HOURS is untouched (the widest
# on-air consumer looks back 72h); past that, one frame per model + variable per
# UTC day is kept forever, nearest KEEPER_HOUR. Zoom-gated regional nests (incl.
# the MRMS radar firehose) keep NEST_KEEP_DAYS and are then dropped whole.
# Set WEATHER_ARCHIVE_THIN=off to pause thinning, e.g. while backfilling history.
# WEATHER_ARCHIVE_FULLRES_HOURS=96
# WEATHER_ARCHIVE_NEST_KEEP_DAYS=7
# WEATHER_ARCHIVE_KEEPER_HOUR=12
# WEATHER_ARCHIVE_THIN_MS=86400000
# WEATHER_ARCHIVE_THIN=off
#
# Alert imagery. Full-res inside FULLRES_HOURS, then the newest still per alert +
# kind per UTC day, then nothing past KEEP_DAYS -- except one keepsake still for
# alerts that actually aired (the as-run log says which). KEEPSAKE=false drops
# those too. ALERT_SNAPSHOT_RETENTION=off pauses the sweep.
# ALERT_SNAPSHOT_FULLRES_HOURS=72
# ALERT_SNAPSHOT_KEEP_DAYS=30
# ALERT_SNAPSHOT_KEEPSAKE=false
# ALERT_SNAPSHOT_PRUNE_MS=86400000
# ALERT_SNAPSHOT_RETENTION=off
#
# Permanent seismic record. The live quake collection has a 31-day TTL, so
# without this every earthquake older than a month is deleted with no copy kept.
# The archive has no TTL; bound it with the magnitude floor, never an expiry.
# It seeds itself on worker boot -- there is no first-run step to remember.
# Defaults to 2.5, matching the USGS feed we ingest, so the record keeps
# everything we see. 0 archives every event the feed carries.
# QUAKE_ARCHIVE_MIN_MAG=2.5
# QUAKE_ARCHIVE_LOOKBACK_DAYS=30
# QUAKE_ARCHIVE_MS=86400000
# QUAKE_ARCHIVE=off
#
# Orphan blob sweep grace: never delete a file written this recently, in case its
# database record is still being written alongside it.
# BLOB_ORPHAN_GRACE_MS=900000
